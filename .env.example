# ── LOCAL DOCKER (default for docker compose) ────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-256-bit-random-key
# Backend Settings reads CORS_ORIGINS (not APP_CORS_ORIGINS)
CORS_ORIGINS=["http://localhost:3050","http://127.0.0.1:3050","http://localhost:3000"]
APP_CORS_ORIGINS=http://localhost:3050,http://localhost:3000,http://localhost:5173

DATABASE_URL=postgresql+asyncpg://feuji:feuji_pass@localhost:5435/llmkit
REDIS_URL=redis://localhost:6381/0

# ── PRODUCTION — set these in Render / Vercel dashboards (do NOT commit secrets)
# Copy Neon / Redis / Render / Vercel values into each platform's Environment UI.
#
# Render (backend service):
#   APP_ENV=production
#   APP_SECRET_KEY=<long random secret>
#   CORS_ORIGINS=["https://YOUR-APP.vercel.app"]
#   DATABASE_URL=postgresql+asyncpg://USER:PASS@HOST.neon.tech/DBNAME?ssl=require
#     (Neon "connection string" — change postgres:// → postgresql+asyncpg://
#      OR leave postgresql:// — backend converts it automatically)
#   REDIS_URL=rediss://default:PASS@HOST:PORT
#     (use rediss:// for TLS Redis / Upstash / Redis Cloud)
#   OPENAI_API_KEY=...   (optional)
#   LLM_PROVIDER=openai
#   LLM_MODEL=gpt-4o
#
# Vercel (frontend — Project Settings → Environment Variables):
#   VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
#   VITE_WS_BASE_URL=wss://YOUR-BACKEND.onrender.com
#
# Neon.tech: create DB, enable SSL, paste connection string into Render DATABASE_URL
# Redis: paste TLS URL into Render REDIS_URL
# After Vercel domain is known, update Render CORS_ORIGINS to that https:// origin

# ── AZURE (Phase 1 — optional) ───────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-service-principal-client-id
AZURE_CLIENT_SECRET=your-service-principal-secret
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── AWS (Phase 1 — optional) ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# ── TERRAFORM / OPTIMA / INTEGRATIONS (optional) ─────────────────────────────
TF_STATE_BUCKET=feuji-tfstate-bucket
TF_STATE_DYNAMODB_TABLE=feuji-tfstate-lock
TF_ARTIFACTS_BUCKET=feuji-tf-artifacts
SECRETS_MANAGER_PREFIX=feuji/llmkit
SECRETS_MANAGER_REGION=us-east-1
OPTIMA_SCAN_INTERVAL_MINUTES=60
OPTIMA_COST_ALERT_THRESHOLD_PCT=85
